---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { imagePhoto } from '../components/photos';
import { site } from '../data';
import '@fontsource-variable/jost/index.css';
import '../styles/global.css';

/**
 * Gabarit commun à toutes les pages : en-tête HTML, référencement, header, footer.
 * Toute page du site doit passer par ce gabarit.
 */
interface Props {
  titre: string;
  description?: string;
  /** Passer true pour demander aux moteurs de recherche d'ignorer la page. */
  noindex?: boolean;
}

const { titre, description = site.description, noindex = false } = Astro.props;

// Google coupe les titres au-delà d'environ 60 caractères.
const titreComplet = `${titre} — ${site.nom}`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlSite = new URL('/', Astro.site);

// Aperçu affiché quand un lien est partagé : format 1200 × 630 attendu par Facebook et WhatsApp.
const photoPartage = await getImage({
  src: imagePhoto(site.photoPartage),
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const urlPhotoPartage = new URL(photoPartage.src, Astro.site);

// Le schéma de site.yaml impose « rue, code postal ville ».
const [, rue, codePostal, ville] = site.contact.adresse.match(/^(.+),\s*(\d{5})\s+(.+)$/) ?? [];

// Fiche d'entreprise pour Google (affichage enrichi dans les résultats de recherche).
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${urlSite}#entreprise`,
  name: site.nom,
  description: site.description,
  url: urlSite.toString(),
  logo: new URL(site.logo, Astro.site).toString(),
  image: urlPhotoPartage.toString(),
  telephone: site.contact.telephone,
  email: site.contact.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: rue,
    postalCode: codePostal,
    addressLocality: ville,
    addressCountry: 'FR',
  },
  areaServed: site.zone,
  sameAs: site.reseaux.map((reseau) => reseau.url),
};

// « @ » écrit \u0040 : Google lit la même adresse, les robots à spam ne la reconnaissent pas.
const donneesStructureesJson = JSON.stringify(donneesStructurees).replace(
  site.contact.email,
  site.contact.email.replace('@', '\\u0040'),
);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={urlPhotoPartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nom}, ${site.metier}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ece8e7" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={donneesStructureesJson} is:inline></script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-button focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data';
import '../styles/global.css';

/**
 * Gabarit commun à toutes les pages : en-tête HTML, référencement, header, footer.
 * Toute page du site doit passer par ce gabarit.
 */
interface Props {
  titre: string;
  description?: string;
  /** Passer true pour demander aux moteurs de recherche d'ignorer la page. */
  noindex?: boolean;
}

const { titre, description = site.description, noindex = false } = Astro.props;

const titreComplet = `${titre} — ${site.nom}, ${site.metier}`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);

// Fiche d'entreprise pour Google (affichage enrichi dans les résultats de recherche).
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nom,
  description: site.description,
  telephone: site.contact.telephone,
  email: site.contact.email,
  address: { '@type': 'PostalAddress', streetAddress: site.contact.adresse },
  areaServed: site.zone,
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(donneesStructurees)}
      is:inline
    ></script>
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-button focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

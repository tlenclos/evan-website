---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';

// Le texte de cette page se modifie dans src/content/pages/a-propos.md
const page = await getEntry('pages', 'a-propos');
if (!page) throw new Error('Le fichier src/content/pages/a-propos.md est introuvable.');
const { Content } = await render(page);
---

<BaseLayout titre={page.data.titre} description={page.data.description}>
  {page.data.hero && <Hero {...page.data.hero} />}

  <Section>
    <div class="prose-site max-w-2xl">
      <Content />
    </div>
    <div class="mt-10">
      <Button href="/contact/">Prendre contact</Button>
    </div>
  </Section>
</BaseLayout>

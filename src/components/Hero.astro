---
import Button from './Button.astro';
import { site } from '../data';

/**
 * Grand bandeau en haut de chaque page. Son contenu vient du fichier Markdown de la page.
 * Avec une « photo », il passe sur deux colonnes : texte à gauche, photo en arche à droite.
 * Le slot sert à ajouter des liens sous le texte (ex. les catégories des réalisations).
 */
interface Props {
  surtitre?: string;
  titre: string;
  texte: string;
  ctaTexte?: string;
  ctaUrl?: string;
  photo?: string;
  photoSecondaire?: string;
  legendePhoto?: string;
}

const {
  surtitre = `${site.metier} · ${site.zone}`,
  titre,
  texte,
  ctaTexte,
  ctaUrl,
  photo,
  photoSecondaire,
  legendePhoto,
} = Astro.props;
---

<div class:list={['relative overflow-hidden', photo ? 'bg-surface' : 'bg-surface-muted']}>
  <!-- Les deux maisons au trait du logo, en décor -->
  <svg
    aria-hidden="true"
    viewBox="0 0 400 400"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class:list={[
      'absolute size-80 text-ink-200 sm:size-130',
      photo ? '-top-4 -right-28 sm:top-10 sm:-left-16' : '-top-10 -right-24 sm:-right-10',
    ]}
  >
    <path d="M30 390 V170 L170 40 L310 170 V390"></path>
    <path d="M110 390 V120 L240 10 L370 120 V390"></path>
  </svg>

  <div
    class:list={[
      'relative mx-auto grid max-w-6xl gap-x-16 gap-y-7 px-4 sm:px-10',
      photo ? 'py-8 sm:py-18 lg:grid-cols-2 lg:items-center' : 'py-12 sm:pt-18 sm:pb-14',
    ]}
  >
    <div class="flex flex-col gap-5 sm:gap-7">
      <p class="surtitre">{surtitre}</p>
      <h1 class="max-w-3xl font-display text-4xl leading-titre font-medium tracking-tight text-ink-700 sm:text-6xl">
        {titre}
      </h1>
      <p class="max-w-xl text-lg leading-relaxed text-ink-800 sm:text-xl">{texte}</p>
    </div>

    {photo && (
      <div class="relative h-96 sm:h-150 lg:col-start-2 lg:row-span-2 lg:row-start-1">
        <img
          src={photo}
          alt={legendePhoto ?? ''}
          class="rounded-arch absolute top-0 right-0 aspect-4/5 w-3/4 object-cover sm:w-4/5"
        />
        {photoSecondaire && (
          <img
            src={photoSecondaire}
            alt=""
            class="absolute bottom-0 left-0 size-36 rounded-full border-6 border-surface object-cover sm:size-56 sm:border-8"
          />
        )}
        {legendePhoto && (
          <p
            aria-hidden="true"
            class="absolute right-6 bottom-11 hidden rounded-button bg-surface px-4 py-2.5 text-sm font-medium text-ink-700 sm:block"
          >
            {legendePhoto}
          </p>
        )}
      </div>
    )}

    {ctaTexte && ctaUrl && (
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <Button href={ctaUrl}>
          {ctaTexte}
          <svg
            aria-hidden="true"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        {ctaUrl !== site.ctaPrincipal.url && (
          <Button href={site.ctaPrincipal.url} variante="secondaire">
            {site.ctaPrincipal.texte}
          </Button>
        )}
      </div>
    )}

    {Astro.slots.has('default') && (
      <div>
        <slot />
      </div>
    )}
  </div>
</div>

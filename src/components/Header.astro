---
import Button from './Button.astro';
import { site } from '../data';

/**
 * En-tête du site : logo + navigation.
 * Le logo et le menu se règlent dans src/data/site.yaml (clés « logo » et « menu »).
 * Le menu mobile utilise <details> : il fonctionne sans JavaScript.
 */
const cheminActuel = Astro.url.pathname;

// « /prestations » et « /prestations/ » doivent être reconnus comme la même page.
const estActif = (url: string) => {
  const normaliser = (valeur: string) => (valeur.endsWith('/') ? valeur : `${valeur}/`);
  return normaliser(cheminActuel) === normaliser(url);
};
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-2.5 sm:px-10 sm:py-3.5">
    <a href="/" class="shrink-0">
      <img src={site.logo} alt={site.nom} width="205" height="320" class="h-13 w-auto sm:h-16" />
    </a>

    <!-- Navigation sur grand écran -->
    <nav aria-label="Navigation principale" class="hidden items-center gap-8 lg:flex">
      {site.menu.map((lien) => (
        <a
          href={lien.url}
          aria-current={estActif(lien.url) ? 'page' : undefined}
          class:list={[
            'text-base transition-colors',
            estActif(lien.url) ? 'font-medium text-brand-600' : 'text-ink-900 hover:text-brand-600',
          ]}
        >
          {lien.texte}
        </a>
      ))}
    </nav>
    <div class="hidden lg:block">
      <Button href={site.ctaPrincipal.url} compact>
        {site.ctaPrincipal.texte}
      </Button>
    </div>

    <!-- Navigation sur mobile et tablette -->
    <details class="relative lg:hidden">
      <summary
        aria-label="Menu"
        class="flex size-12 cursor-pointer items-center justify-center rounded-button border-2 border-ink-300 text-ink-700 marker:content-['']"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
      </summary>
      <nav
        aria-label="Navigation principale"
        class="absolute right-0 mt-2 w-60 rounded-card border border-ink-200 bg-surface p-2 shadow-card"
      >
        {site.menu.map((lien) => (
          <a
            href={lien.url}
            aria-current={estActif(lien.url) ? 'page' : undefined}
            class:list={[
              'block rounded-button px-4 py-2.5 text-base',
              estActif(lien.url)
                ? 'bg-brand-50 font-medium text-brand-700'
                : 'text-ink-800 hover:bg-ink-100',
            ]}
          >
            {lien.texte}
          </a>
        ))}
        <Button href={site.ctaPrincipal.url} class="mt-2 w-full">
          {site.ctaPrincipal.texte}
        </Button>
      </nav>
    </details>
  </div>
</header>

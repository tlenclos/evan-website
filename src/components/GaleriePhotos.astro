---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { imagePhoto, type Cadre } from './photos';
import type { PhotoRealisation } from '../data';

/**
 * Grille de photos de chantiers. Les photos et leurs légendes viennent de
 * src/data/realisations.yaml. Un clic ouvre la photo en grand, sans JavaScript.
 * La photo du milieu de chaque rangée est coiffée d'une arche.
 */
interface Props {
  photos: PhotoRealisation[];
}

const { photos } = Astro.props;

const cadresPhoto: Cadre[] = [
  { ecranMin: 1152, largeur: 341, ratio: 0.8 },
  { ecranMin: 1024, largeur: [33.33, -42.67], ratio: 0.8 },
  { ecranMin: 640, largeur: [50, -52], ratio: 0.8 },
  { largeur: [50, -22], ratio: 0.8 },
];

// Version plein format, ouverte au clic.
const photosEnGrand = await Promise.all(
  photos.map((photo) => getImage({ src: imagePhoto(photo.fichier), format: 'webp' })),
);
---

<ul class="grid grid-cols-2 gap-x-3 gap-y-6 sm:gap-x-6 sm:gap-y-10 lg:grid-cols-3">
  {photos.map((photo, index) => (
    <li>
      <figure>
        <a href={photosEnGrand[index]?.src} class="group relative block">
          <Photo
            adresse={photo.fichier}
            alt={photo.legende}
            cadres={cadresPhoto}
            class={`aspect-4/5 w-full bg-ink-100 object-cover transition-opacity group-hover:opacity-90 ${index % 3 === 1 ? 'rounded-arch' : 'rounded-card'}`}
          />
          {photo.etiquette && (
            <span class="absolute top-3 left-3 rounded-button bg-ink-900 px-3.5 py-1.5 text-xs font-medium tracking-widest text-ink-50 uppercase sm:top-4 sm:left-4">
              {photo.etiquette}
            </span>
          )}
        </a>
        <figcaption class="mt-3 leading-snug font-medium text-ink-900 sm:text-lg">
          {photo.legende}
        </figcaption>
      </figure>
    </li>
  ))}
</ul>

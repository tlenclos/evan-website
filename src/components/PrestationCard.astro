---
/** Carte présentant une prestation. Les données viennent de src/data/prestations.yaml. */
interface Props {
  titre: string;
  description: string;
  tarif?: string;
  details?: string[];
}

const { titre, description, tarif, details } = Astro.props;
---

<article class="flex h-full flex-col rounded-card border border-ink-200 bg-surface p-6 shadow-card">
  <h3 class="font-display text-xl text-ink-900">{titre}</h3>
  {tarif && <p class="mt-1 text-sm font-semibold text-brand-700">{tarif}</p>}
  <p class="mt-3 leading-relaxed text-ink-600">{description}</p>
  {details && details.length > 0 && (
    <ul class="mt-4 space-y-2 border-t border-ink-200 pt-4 text-sm text-ink-600">
      {details.map((detail) => (
        <li class="flex gap-2">
          <span class="text-brand-600" aria-hidden="true">
            —
          </span>
          <span>{detail}</span>
        </li>
      ))}
    </ul>
  )}
</article>

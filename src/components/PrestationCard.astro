---
import Photo from './Photo.astro';
import type { Cadre } from './photos';

/** Carte présentant une prestation. Les données viennent de src/data/prestations.yaml. */
interface Props {
  titre: string;
  description: string;
  tarif?: string;
  details?: string[];
  photo?: string;
}

const { titre, description, tarif, details, photo } = Astro.props;

const cadresPhoto: Cadre[] = [
  { ecranMin: 1152, largeur: 337, hauteur: 288 },
  { ecranMin: 1024, largeur: [33.33, -47.33], hauteur: 288 },
  { ecranMin: 640, largeur: [50, -56], hauteur: 288 },
  { largeur: [100, -34], hauteur: 208 },
];
---

<article class="flex h-full flex-col overflow-hidden rounded-card border border-ink-200 bg-surface">
  {photo && (
    <Photo adresse={photo} alt="" cadres={cadresPhoto} class="h-52 w-full object-cover sm:h-72" />
  )}
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <h3 class="font-display text-2xl font-medium text-ink-700">{titre}</h3>
    {tarif && <p class="mt-1 text-sm font-medium text-brand-700">{tarif}</p>}
    <p class="mt-2 leading-relaxed text-ink-800">{description}</p>
    {details && details.length > 0 && (
      <ul class="mt-5 space-y-2 border-t border-ink-200 pt-5 text-ink-800">
        {details.map((detail) => (
          <li class="flex gap-3">
            <span class="text-argile-400" aria-hidden="true">
              —
            </span>
            <span>{detail}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
